{
  "name": "type-editor",
  "version": "0.1.1",
  "description": "Type Editor — a Markdown editor with live preview, LaTeX and PNG/Word export",
  "main": "./out/main/index.js",
  "author": {
    "name": "Datatype Team",
    "email": "hello@dtio.org",
    "url": "https://dtio.org"
  },
  "license": "MIT",
  "private": true,
  "homepage": "https://dtio.org",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "harness": "vite build --config vite.harness.config.ts",
    "smoke": "npm run build && npm run harness && electron scripts/smoke.cjs",
    "test": "npm run typecheck && npm run smoke",
    "screenshot": "electron scripts/screenshot.cjs",
    "docs:shots": "electron scripts/docs-shots.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "docx": "^9.7.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.7",
    "lucide-react": "^1.45.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
